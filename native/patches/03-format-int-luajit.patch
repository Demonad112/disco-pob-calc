+/*
+** disco-pob-calc patch: LuaJIT (x86-64) semantics for %d/%i/%o/%u/%x/%X. The number is truncated
+** toward zero as cvttsd2si does: NaN, +-inf and anything outside int64 become INT64_MIN. Lua 5.2
+** raises "not a number in proper range" instead, and a plain C cast is undefined (it traps in wasm).
+*/
+static LUA_INTFRM_T pob_num2intfrm (lua_Number n) {
+  if (n != n || n >= 9223372036854775808.0 || n < -9223372036854775808.0)
+    return (LUA_INTFRM_T)(-9223372036854775807LL - 1);
+  return (LUA_INTFRM_T)n;
+}
+
+
 static int str_format (lua_State *L) {
   int top = lua_gettop(L);
   int arg = 1;
@@ -916,20 +928,14 @@
