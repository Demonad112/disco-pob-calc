diff -ru a/src/lparser.c b/src/lparser.c
--- a/src/lparser.c	2026-11-26 18:30:23.300315400 +0000
+++ b/src/lparser.c	2026-11-26 18:30:23.325846013 +0000
@@ -1477,12 +1477,56 @@
 }
 
 
+/*
+** disco-pob-calc patch: compound assignment `v op= exp` (op one of + - * / % ^ ..),
+** the syntax PoB's LuaJIT accepts. Single target only. The target's table and key
+** are evaluated once: for an indexed target their registers are kept and the
+** current value is read into a fresh register above them.
+*/
+static BinOpr compoundopr (int tok) {
+  switch (tok) {
+    case TK_ADDEQ: return OPR_ADD;
+    case TK_SUBEQ: return OPR_SUB;
+    case TK_MULEQ: return OPR_MUL;
+    case TK_DIVEQ: return OPR_DIV;
+    case TK_MODEQ: return OPR_MOD;
+    case TK_POWEQ: return OPR_POW;
+    case TK_CONCATEQ: return OPR_CONCAT;
+    default: return OPR_NOBINOPR;
+  }
+}
+
+
+static void compoundassign (LexState *ls, expdesc *v, BinOpr op) {
+  FuncState *fs = ls->fs;
+  expdesc cur, rhs;
+  int line = ls->linenumber;
+  check_condition(ls, vkisvar(v->k), "syntax error");
+  luaX_next(ls);  /* skip operator */
+  if (v->k == VINDEXED) {
+    int reg = fs->freereg;
+    OpCode o = (v->u.ind.vt == VLOCAL) ? OP_GETTABLE : OP_GETTABUP;
+    luaK_reserveregs(fs, 1);
+    luaK_codeABC(fs, o, reg, v->u.ind.t, v->u.ind.idx);
+    init_exp(&cur, VNONRELOC, reg);
+  }
+  else
+    cur = *v;  /* local or upvalue: reading it frees nothing */
+  luaK_infix(fs, op, &cur);
+  expr(ls, &rhs);
+  luaK_posfix(fs, op, &cur, &rhs, line);
+  luaK_storevar(fs, v, &cur);
+}
+
+
 static void exprstat (LexState *ls) {
   /* stat -> func | assignment */
   FuncState *fs = ls->fs;
   struct LHS_assign v;
   suffixedexp(ls, &v.v);
-  if (ls->t.token == '=' || ls->t.token == ',') { /* stat -> assignment ? */
+  if (compoundopr(ls->t.token) != OPR_NOBINOPR)  /* stat -> compound assignment */
+    compoundassign(ls, &v.v, compoundopr(ls->t.token));
+  else if (ls->t.token == '=' || ls->t.token == ',') { /* stat -> assignment ? */
     v.prev = NULL;
     assignment(ls, &v, 1);
   }
